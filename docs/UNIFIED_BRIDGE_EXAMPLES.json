{
  "example1_deploy_everything": {
    "description": "Deploy all contracts fresh on both chains",
    "endpoint": "PUT http://localhost:3001/deploy/bridge",
    "request": {
      "homeChain": {
        "rpcUrl": "https://api.avax-test.network/ext/bc/C/rpc",
        "blockchainId": "0x7fc93d85c6d62c5b2ac0b519c87010ea5294012d1e407030d6acd0021cac10d5",
        "tokenAddress": "0x5425890298aed601595a70AB815c96711a31Bc65",
        "tokenDecimals": 18,
        "teleporterMessenger": {
          "deploy": true
        },
        "teleporterRegistry": {
          "deploy": true
        },
        "gasLimit": 8000000
      },
      "remoteChain": {
        "rpcUrl": "https://subnets.avax.network/mysubnet/rpc",
        "blockchainId": "0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef",
        "teleporterManagerAddress": "0x1234567890123456789012345678901234567890",
        "tokenName": "Wrapped USDC",
        "tokenSymbol": "WUSDC",
        "tokenDecimals": 18,
        "initialReserveImbalance": 0,
        "teleporterMessenger": {
          "deploy": true
        },
        "teleporterRegistry": {
          "deploy": true
        },
        "gasLimit": 8000000
      }
    }
  },
